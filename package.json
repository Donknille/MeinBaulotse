{
  "name": "meinbaulotse",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build && pnpm --filter @meinbaulotse/web build",
    "dev": "pnpm --parallel --filter @meinbaulotse/api --filter @meinbaulotse/web dev",
    "typecheck": "pnpm -r typecheck && tsc -p api/tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm --filter @meinbaulotse/schedule test",
    "test:all": "pnpm -r test",
    "db:up": "docker compose up -d db",
    "db:reset": "pnpm --filter @meinbaulotse/db reset",
    "db:test": "pnpm --filter @meinbaulotse/db test"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.20.1",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0",
    "vitest": "^3.0.4"
  },
  "dependencies": {
    "hono": "^4.6.16"
  }
}
