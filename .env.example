# ---------------------------------------------------------------------------
# Lokale Entwicklung: Postgres aus docker-compose.yml. Kein Supabase-Konto noetig.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:54329/meinbaulotse

# ---------------------------------------------------------------------------
# Supabase. Werte stammen aus DEINEM Projekt (Dashboard -> Project Settings).
# Lokal reicht das Test-Secret unten; es signiert die selbst erzeugten Test-JWTs.
# ---------------------------------------------------------------------------
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-key>
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# ---------------------------------------------------------------------------
# Web (oeffentlich, landet im Browser-Bundle)
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>

# Port des lokalen API-Servers (auf Vercel laeuft die API unter /api)
API_PORT=8787

# ---------------------------------------------------------------------------
# Wetter fuer das Bautagebuch (Abschnitt 3.8)
#
# Quelle ist DWD Open Data. Der DWD liefert Tageswerte als ZIP-Archive mit
# einem Stationskatalog in fester Spaltenbreite daneben; api.brightsky.dev ist
# ein quelloffener, kostenfreier Dienst, der genau diese Daten als JSON
# ausliefert und die Stationswahl nach Koordinaten mitmacht.
#
# Nicht gesetzt: der Standard oben wird benutzt.
# Leer gesetzt:  kein Wetter. Im Tagebuch steht dann „Wetter nicht erfasst" —
#                das ist ehrlicher als eine erfundene Zahl.
# Eigene Adresse: Brightsky laesst sich selbst betreiben (Docker), dann bleibt
#                die Abfrage im eigenen Haus.
# ---------------------------------------------------------------------------
WEATHER_API_URL=https://api.brightsky.dev

# ---------------------------------------------------------------------------
# Testzugang ohne Mailversand (siehe docs/DEMO.md)
#
# Gesetzt: /demo und POST /api/demo/session sind erreichbar, und wer den
# Schluessel hat, kann sich als Bauherr oder als Generalunternehmer anmelden.
# Leer: die Route existiert nicht. So gehoert es in die Produktionsumgebung.
# Mindestens 16 Zeichen, sonst bleibt der Zugang aus.
# ---------------------------------------------------------------------------
DEMO_LOGIN_KEY=
