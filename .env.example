# ---------------------------------------------------------------------------
# Lokale Entwicklung: Postgres aus docker-compose.yml. Kein Supabase-Konto noetig.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:54329/meinbaulotse

# ---------------------------------------------------------------------------
# Supabase. Werte stammen aus DEINEM Projekt (Dashboard -> Project Settings).
# Lokal reicht das Test-Secret unten; es signiert die selbst erzeugten Test-JWTs.
# ---------------------------------------------------------------------------
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-key>
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# ---------------------------------------------------------------------------
# Web (oeffentlich, landet im Browser-Bundle)
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>

# Port des lokalen API-Servers (auf Vercel laeuft die API unter /api)
API_PORT=8787
